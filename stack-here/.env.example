# Optional. If set, Postgres is used instead of the local SQLite file.
DATABASE_URL=
# Optional. Where the SQLite file lives (default ./.data/stack-here.db, or /tmp on Vercel).
SQLITE_PATH=
# Password for /insights. Required in production; in dev the page is open when unset.
ADMIN_PASSWORD=
# Vercel Cron sends this as a bearer token to /api/cron/refresh.
CRON_SECRET=
# Public origin used in share links and OG tags, e.g. https://stack.here
NEXT_PUBLIC_SITE_URL=
