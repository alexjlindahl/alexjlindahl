# Copy to .env and fill in. Everything is optional for local development except ADMIN_PASSWORD (needed for /admin).

# Password for /admin
ADMIN_PASSWORD=

# Public URL of the site, used in share links and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. When unset, SQLite at data/gtmtakes.db is used.
DATABASE_URL=

# X API v2 bearer token for `npm run fetch-takes`. Without it, import a CSV instead.
X_BEARER_TOKEN=

# Enables the LLM review step in `npm run fetch-takes` (filter to real opinions + neutral rewrite).
ANTHROPIC_API_KEY=
# TAKES_MODEL=claude-opus-5-5

# Secret mixed into the IP hash. Set a long random string in production.
IP_HASH_SALT=

# Day boundary for "today's takes" (IANA timezone). Default America/New_York.
# SITE_TZ=America/New_York
# Votes allowed per take from one IP address. Default 5.
# MAX_VOTES_PER_IP=5
